# Copy to .env.rightcodes.local and set permissions to 0600.
# The provider must return this requested model; mismatches fail the probe.
AIRLINE_MODEL_PROVIDER=rightcodes
AIRLINE_MODEL_BASE_URL=https://www.rightapi.ai/codex/v1
AIRLINE_MODEL=gpt-5.6-sol
AIRLINE_MODEL_API_KEY=
# User-reported limit on the provider key; this file does not enforce billing.
AIRLINE_MODEL_BUDGET_USD=5
# Optional local service workflow; demo operators and channel receipts are simulated.
AIRLINE_SERVICE_TRIAL=0
